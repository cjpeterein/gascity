# gc import migrate is now a deprecated compatibility shim.

env GC_SESSION=fake
env GC_BEADS=file
env GC_DOLT=skip

cd $WORK/legacy-city

! exec gc import migrate --dry-run
stderr 'gc import migrate has been deprecated\.'
stderr 'Use "gc doctor" to inspect legacy pack surfaces\.'
stderr 'Use "gc doctor --fix" for the safe mechanical cases that currently have automatic rewrites'
stderr 'no longer performs in-place legacy-to-current pack rewrites'
stderr 'docs/guides/shareable-packs.md'
! exists $WORK/legacy-city/pack.toml
exec grep '\[\[agent\]\]' $WORK/legacy-city/city.toml

! exec gc import migrate
stderr 'gc import migrate has been deprecated\.'
stderr 'gc doctor --fix'
stderr 'no longer performs in-place legacy-to-current pack rewrites'
! exists $WORK/legacy-city/pack.toml
exec grep '^includes = ' $WORK/legacy-city/city.toml
exec grep 'default_rig_includes = \["../packs/default rig"\]' $WORK/legacy-city/city.toml

# Rig-scoped user agents get a matching [[named_session]] synthesized in city.toml.
# The synthesis itself moved out of `gc import migrate` (now a deprecation shim
# that performs no rewrites) into `gc doctor --fix`, which still calls the
# underlying migrate.Apply path.
exec gc doctor --fix
exists $WORK/legacy-city/agents/wolf/agent.toml
exec grep '\[\[named_session\]\]' $WORK/legacy-city/city.toml
exec grep 'template = "wolf"' $WORK/legacy-city/city.toml
exec grep 'dir = "myproject"' $WORK/legacy-city/city.toml
exec grep 'mode = "always"' $WORK/legacy-city/city.toml

-- legacy-city/city.toml --
[workspace]
name = "legacy-city"
includes = ["../packs/gastown"]
default_rig_includes = ["../packs/default rig"]

[[agent]]
name = "mayor"
provider = "claude"
prompt_template = "prompts/mayor.md"
overlay_dir = "overlays/mayor"
namepool = "namepools/mayor.txt"
fallback = true

[[agent]]
name = "wolf"
dir = "myproject"
scope = "rig"
prompt_template = "prompts/wolf.md"

-- legacy-city/prompts/mayor.md --
Hello {{.Agent}}

-- legacy-city/prompts/wolf.md --
howl

-- legacy-city/overlays/mayor/CLAUDE.md --
overlay

-- legacy-city/namepools/mayor.txt --
Ada
Grace
